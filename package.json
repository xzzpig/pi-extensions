{
  "name": "pi-extensions",
  "version": "0.1.0",
  "private": true,
  "description": "A pnpm monorepo for pi extensions and packages.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "pi": {
    "extensions": [
      "./packages/pi-notify/extensions/index.ts"
    ]
  },
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": ">=11.13.1 <12"
  },
  "scripts": {
    "audit:fork-divergence": "bash .agents/skills/pi-fork-divergence/scripts/audit-fork-divergence.sh --all",
    "verify": "pnpm run audit:fork-divergence && pnpm exec prettier --check .",
    "publish:all": "bash scripts/publish-all.sh",
    "publish:check": "bash scripts/publish-all.sh --dry-run"
  },
  "devDependencies": {
    "prettier": "3.6.2"
  }
}
