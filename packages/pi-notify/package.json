{
  "name": "@xzzpig/pi-notify",
  "version": "0.1.0",
  "description": "Cross-device notifications for Pi: OSC terminal notifications, ntfy push channels, semantic Pi events, and Herdr blocked-state integration.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xzzpig/pi-extensions.git",
    "directory": "packages/pi-notify"
  },
  "homepage": "https://github.com/xzzpig/pi-extensions/tree/main/packages/pi-notify#readme",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "notifications",
    "ntfy",
    "terminal",
    "herdr"
  ],
  "files": [
    "api.ts",
    "extensions",
    "config",
    "assets",
    "README.md",
    "package.json"
  ],
  "exports": {
    ".": "./api.ts",
    "./api": "./api.ts",
    "./extensions/*": "./extensions/*",
    "./package.json": "./package.json"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "dotenv-expand": "13.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
