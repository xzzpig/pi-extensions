{
  "name": "@xzzpig/pi-mouse-events",
  "version": "0.2.0",
  "description": "Mouse event dispatch for Pi's fullscreen TUI: a global mouse event channel and handler slots for other extensions.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xzzpig/pi-extensions.git",
    "directory": "packages/pi-mouse-events"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-tui",
    "mouse",
    "tui"
  ],
  "files": [
    "extensions",
    "api.ts",
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/public.d.ts",
      "default": "./api.ts"
    },
    "./api": {
      "types": "./dist/public.d.ts",
      "default": "./api.ts"
    },
    "./test-support": {
      "types": "./dist/test-support.d.ts",
      "default": "./extensions/test-support.ts"
    }
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build:types": "rollup -c rollup.dts.config.mjs",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.86.0 <0.88",
    "@earendil-works/pi-tui": ">=0.86.0 <0.88"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.87.1",
    "@earendil-works/pi-tui": "^0.87.1",
    "@types/node": "catalog:",
    "rollup": "^4.62.2",
    "rollup-plugin-dts": "^6.4.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
