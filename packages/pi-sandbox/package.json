{
  "name": "@xzzpig/pi-sandbox",
  "version": "0.7.1",
  "description": "OS-level sandboxing for pi with interactive permission prompts",
  "keywords": [
    "pi-package",
    "pi-extension"
  ],
  "type": "module",
  "main": "./index.ts",
  "types": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./service": "./src/service.ts"
  },
  "packageManager": "pnpm@11.13.1",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xzzpig/pi-extensions.git",
    "directory": "packages/pi-sandbox"
  },
  "author": "Chris Arderne <chris@rdrn.me>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/xzzpig/pi-extensions/issues"
  },
  "homepage": "https://github.com/xzzpig/pi-extensions/tree/main/packages/pi-sandbox#readme",
  "scripts": {
    "fmt": "oxfmt index.ts src test",
    "lint": "oxlint index.ts src test",
    "check": "tsc --noEmit",
    "test": "tsx --test test/**/*.test.ts",
    "all": "pnpm run fmt && pnpm run lint && pnpm run check && pnpm test",
    "ci:fmt": "oxfmt --check index.ts src test",
    "ci:lint": "pnpm run lint",
    "ci:check": "pnpm run check",
    "ci:test": "pnpm test",
    "prepack": "node scripts/pack-bundle.mjs",
    "postpack": "node scripts/pack-bundle.mjs --clean"
  },
  "dependencies": {
    "@xzzpig/sandbox-runtime": "workspace:*"
  },
  "bundledDependencies": [
    "@xzzpig/sandbox-runtime"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.0.0 <2",
    "@earendil-works/pi-tui": "*",
    "@xzzpig/pi-tool-display": ">=0.1.1"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@xzzpig/pi-tool-display": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "catalog:",
    "@earendil-works/pi-tui": "catalog:",
    "@types/node": "^24",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "tsx": "^4.23.1",
    "typescript": "^5"
  },
  "pnpm": {
    "overrides": {
      "minimatch": ">=10.2.1",
      "lodash-es": ">=4.18.1",
      "brace-expansion@>=4.0.0 <5.0.8": ">=5.0.8",
      "undici@>=8.0.0 <8.9.0": ">=8.9.0",
      "brace-expansion@>=4.0.0 <5.0.9": ">=5.0.9",
      "undici@>=8.1.0 <8.10.2": ">=8.10.2",
      "undici@>=8.0.0 <8.10.2": ">=8.10.2",
      "brace-expansion@>=4.0.0 <5.0.12": ">=5.0.12",
      "brace-expansion@>=4.0.0 <5.0.11": ">=5.0.11",
      "brace-expansion@>=4.0.0 <5.0.10": ">=5.0.10"
    }
  }
}
