{
	"name": "@xzzpig/pi-starline",
	"version": "0.7.2",
	"description": "A Starship-inspired statusline and Opencode-style TUI for Pi.",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/xzzpig/pi-extensions.git"
	},
	"homepage": "https://github.com/Andy8647/pi-starline#readme",
	"bugs": {
		"url": "https://github.com/Andy8647/pi-starline/issues"
	},
	"keywords": [
		"pi-package",
		"pi-extension",
		"pi-theme",
		"starship",
		"tui"
	],
	"files": [
		"extensions",
		"dist",
		"types",
		"FORK-CHANGELOG.md"
	],
	"scripts": {
		"lint": "biome check .",
		"typecheck": "tsc --noEmit",
		"build:types": "rollup -c rollup.dts.config.mjs && biome format --write dist/public.d.ts",
		"prepack": "pnpm run build:types",
		"test": "vitest run",
		"pi:dev": "${PI_BIN:-/opt/homebrew/bin/pi} --no-extensions -e ./extensions/starline/index.ts",
		"pi:install-local": "${PI_BIN:-/opt/homebrew/bin/pi} install ./ -l",
		"fmt": "biome format --write .",
		"fmt:check": "biome format .",
		"verify": "npm run lint && npm run typecheck && npm run test",
		"pack:check": "npm pack --dry-run",
		"prepublishOnly": "npm run verify && npm run pack:check"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": ">=1.0.0 <2",
		"@earendil-works/pi-coding-agent": ">=1.0.0 <2",
		"@earendil-works/pi-tui": ">=1.0.0 <2",
		"@xzzpig/pi-mouse-events": ">=0.2.0 <3"
	},
	"pi": {
		"extensions": [
			"./extensions"
		],
		"image": "https://raw.githubusercontent.com/Andy8647/pi-starline/main/assets/cover.png"
	},
	"publishConfig": {
		"access": "public"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.3",
		"@earendil-works/pi-ai": "catalog:",
		"@earendil-works/pi-coding-agent": "catalog:",
		"@earendil-works/pi-tui": "catalog:",
		"@types/node": "^26.0.0",
		"rollup": "^4.62.2",
		"rollup-plugin-dts": "^6.4.1",
		"typescript": "^7.0.2",
		"vitest": "^4.1.8",
		"@xzzpig/pi-mouse-events": "workspace:*"
	},
	"peerDependenciesMeta": {
		"@xzzpig/pi-mouse-events": {
			"optional": true
		}
	}
}
