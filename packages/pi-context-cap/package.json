{
  "name": "@lukeramsden/pi-context-cap",
  "version": "1.0.1",
  "description": "Extension for the pi coding agent: enforce a context token budget (default 200k) by forcing compaction, including mid-turn during long tool loops, instead of riding long-context models up to 1M.",
  "license": "MIT",
  "author": "lukeramsden",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lukeramsden/pi-context-cap.git"
  },
  "homepage": "https://github.com/lukeramsden/pi-context-cap#readme",
  "bugs": "https://github.com/lukeramsden/pi-context-cap/issues",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "context-window",
    "compaction",
    "context-management"
  ],
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "files": [
    "extensions",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && node scripts/verify.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.83.0",
    "@earendil-works/pi-coding-agent": "^0.83.0",
    "jiti": "2.7.0",
    "typescript": "^5.9.0"
  }
}
