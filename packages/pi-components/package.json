{
  "name": "@xzzpig/pi-components",
  "version": "0.4.0",
  "private": true,
  "description": "Reusable transcript components for Pi extensions.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-tui",
    "transcript",
    "components"
  ],
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    "./transcript": {
      "types": "./dist/src/transcript.d.ts",
      "default": "./src/transcript.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest --run"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=1.0.0 <2",
    "@earendil-works/pi-coding-agent": ">=1.0.0 <2",
    "@earendil-works/pi-tui": ">=1.0.0 <2"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "catalog:",
    "@earendil-works/pi-coding-agent": "catalog:",
    "@earendil-works/pi-tui": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
