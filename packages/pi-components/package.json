{
  "name": "@xzzpig/pi-components",
  "version": "0.1.1",
  "private": true,
  "description": "Reusable transcript components for Pi extensions.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-tui",
    "transcript",
    "components"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./transcript": {
      "types": "./dist/src/transcript.d.ts",
      "default": "./dist/src/transcript.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest --run"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.83.0 <1",
    "@earendil-works/pi-coding-agent": ">=0.83.0 <1",
    "@earendil-works/pi-tui": ">=0.83.0 <1"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.83.0",
    "@earendil-works/pi-coding-agent": "catalog:",
    "@earendil-works/pi-tui": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
