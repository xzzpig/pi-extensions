{
  "name": "@xzzpig/pi-vibeguard",
  "version": "0.2.1",
  "description": "Pi extension that replaces sensitive strings with placeholders before LLM requests (inspired by VibeGuard), with local /vibeguard:list and /vibeguard:stats mapping viewers and session-scoped temporary suspension (/vibeguard:disable|enable|status|categories).",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/aizigao/pi-vibeguard#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xzzpig/pi-extensions.git",
    "directory": "packages/pi-vibeguard"
  },
  "bugs": {
    "url": "https://github.com/aizigao/pi-vibeguard/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "vibeguard"
  ],
  "files": [
    "index.ts",
    "mapping-view.ts",
    "category-picker.ts",
    "suspension-filter.ts",
    "README.md",
    "CHANGELOG.md",
    "vibeguard.config.json.example",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.74.0 <0.88",
    "@earendil-works/pi-tui": ">=0.74.0 <0.88"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "catalog:",
    "@earendil-works/pi-tui": "catalog:",
    "@types/node": "catalog:",
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "typescript": "catalog:",
    "typescript-eslint": "^8.46.4",
    "vitest": "catalog:"
  }
}
