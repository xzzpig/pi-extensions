if ! has nix_direnv_version || ! nix_direnv_version 3.2.0; then
  source_url "https://raw.githubusercontent.com/nix-community/nix-direnv/3.2.0/direnvrc" "sha256-hW6NC1JHue3IjZN3uDM6l6I2PMaauqd2D7hXYJ1Zfr4="
fi

use flake

watch_file "$PWD/env/ensure-upstreams.mjs"
watch_file "$PWD/env/subtree-metadata.mjs"
watch_file "$PWD/schemas/subtree-metadata.schema.json"

if [ -d "$PWD/subtrees" ]; then
  for upstream_metadata in "$PWD"/subtrees/*.json; do
    [ -f "$upstream_metadata" ] && watch_file "$upstream_metadata"
  done
fi

if [ -f "$PWD/env/ensure-upstreams.mjs" ]; then
  upstream_exports="$(node "$PWD/env/ensure-upstreams.mjs")" || exit 1
  eval "$upstream_exports"
  unset upstream_exports
fi
